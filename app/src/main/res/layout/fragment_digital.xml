<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Status Bar -->
        <TextView
            android:id="@+id/tv_sensor_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Sensor Active"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Pitch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PITCH [X-AXIS]"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_pitch_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00°"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_pitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="#3300E5FF"
                    android:progress="50"
                    android:max="100" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Roll Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:strokeColor="?attr/colorSecondary"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROLL [Y-AXIS]"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_roll_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00°"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorSecondary" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_roll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="?attr/colorSecondary"
                    app:trackColor="#33B300FF"
                    android:progress="50"
                    android:max="100" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Yaw Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:strokeColor="?attr/colorTertiary"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YAW [HEADING]"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_yaw_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00°"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorTertiary" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_yaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    app:indicatorColor="?attr/colorTertiary"
                    app:trackColor="#3339FF14"
                    android:progress="50"
                    android:max="100" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Raw Accelerometer Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#05FFFFFF"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCELEROMETER RAW"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_accel_x"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="X: 0.000"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_accel_y"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Y: 0.000"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_accel_z"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Z: 9.810"
                        android:textSize="14sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="SAVE MEASUREMENT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="monospace"
            app:cornerRadius="32dp"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary" />

    </LinearLayout>
</ScrollView>
